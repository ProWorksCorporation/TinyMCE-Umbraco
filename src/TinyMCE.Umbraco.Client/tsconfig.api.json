{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist-cms",
		"rootDir": "./src",
		"sourceMap": false,
		"declaration": true,
		"declarationMap": true,
		"allowJs": true,
		"noEmit": false,
		"allowImportingTsExtensions": false,
		// Test globals stay out of the published typings.
		"types": ["@umbraco-cms/backoffice/extension-types"]
	},
	// Tests and their fixtures are not part of the npm package.
	"exclude": ["src/**/*.test.ts", "src/test-utils/**"]
}
